# Supabase Postgres. DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true); DIRECT_URL = direct connection (port 5432), used for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Random string, 32+ characters (e.g. `openssl rand -base64 48`). Signs the session cookie.
AUTH_SECRET=""

# Public address of the app, used in email links. Example: https://pdm.yourdomain.com
APP_URL=""

# Supabase Storage: create a PUBLIC bucket with this name. The service role key stays on the server only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="pdm-photos"

# SendGrid. EMAIL_FROM must be a verified sender or domain.
SENDGRID_API_KEY=""
EMAIL_FROM=""

# Protects the daily overdue-CONF job. Vercel Cron sends it automatically when this variable is set.
CRON_SECRET=""

# Timezone used on the server to decide "today" (Requested dates, overdue emails).
APP_TIMEZONE="America/Mexico_City"

# Only read by `npm run db:seed`: the first Admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
